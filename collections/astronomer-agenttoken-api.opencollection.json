                "name": "organizationId",
                "value": "",
                "type": "path",
                "description": "The ID of the organization that owns the deployment where you want to delete the Agent API Token."
              },
              {
                "name": "deploymentId",
                "value": "",
                "type": "path",
                "description": "The ID of the deployment that owns the Agent API token that you want to delete."
              },
              {
                "name": "agentTokenId",
                "value": "",
                "type": "path",
                "description": "The ID of the Agent API token you want to delete."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete an Agent API Token."
